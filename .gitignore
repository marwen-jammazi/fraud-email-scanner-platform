# -------------------------
# IDE / Editor files
# -------------------------
.idea/
*.iml
.vscode/

# -------------------------
# Node / Angular frontend
# -------------------------
frontend/node_modules/
frontend/dist/
frontend/out-tsc/

# Hide Angular environment configs (sensitive)
frontend/src/environments/environment.ts
frontend/src/environments/environment.prod.ts

# -------------------------
# Java / Spring Boot backend
# -------------------------
backend/**/target/
backend/**/.mvn/
backend/**/.idea/

# Hide Spring Boot configs (sensitive)
backend/**/src/main/resources/application.properties
backend/**/src/main/resources/application.yml

# -------------------------
# Python ML service
# -------------------------
ml-service/.idea/
ml-service/__pycache__/
ml-service/*.pkl
ml-service/*.csv

# -------------------------
# Logs / Temp files
# -------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
